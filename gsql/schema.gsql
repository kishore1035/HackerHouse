DROP ALL
CREATE VERTEX Customer(PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Card(PRIMARY_ID id STRING, customer_id STRING, network STRING, card_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX Transaction(PRIMARY_ID id STRING, amount DOUBLE, ts DATETIME, product STRING, channel STRING, risk_score DOUBLE, card_id STRING, region STRING, country STRING, p_email STRING, r_email STRING, device_id STRING, dist1 DOUBLE, d1 DOUBLE, c1 DOUBLE, c2 DOUBLE, c5 DOUBLE, c13 DOUBLE, c14 DOUBLE, m_false INT, m_true INT, dev_new STRING, proxy_type STRING, match_status STRING, dev_kind STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX DeviceProfile(PRIMARY_ID id STRING, device_info STRING, os STRING, browser STRING, screen STRING, device_type STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX EmailDomain(PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX BillingRegion(PRIMARY_ID id STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX ClosedCase(PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME, outcome STRING, pattern STRING, first_txn STRING, n_txns INT, exposure DOUBLE, actions STRING, report_filed STRING, notes STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX AgentCase(PRIMARY_ID id STRING, case_ref STRING, status STRING, verdict STRING, pattern STRING, probability DOUBLE, exposure DOUBLE, summary STRING, created_at DATETIME, updated_at DATETIME, record STRING) WITH primary_id_as_attribute="true"
CREATE VERTEX PolicyChunk(PRIMARY_ID id STRING, source STRING, section STRING, text STRING) WITH primary_id_as_attribute="true"

CREATE DIRECTED EDGE OWNS(FROM Customer, TO Card) WITH REVERSE_EDGE="OWNED_BY"
CREATE DIRECTED EDGE MADE(FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE(FROM Transaction, TO DeviceProfile) WITH REVERSE_EDGE="DEVICE_OF"
CREATE DIRECTED EDGE PURCHASER_EMAIL(FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="EMAIL_OF"
CREATE DIRECTED EDGE BILLED_IN(FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="BILLING_OF"
CREATE DIRECTED EDGE NEXT(FROM Transaction, TO Transaction)
CREATE DIRECTED EDGE INVOLVES(FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="INVOLVED_IN"
CREATE DIRECTED EDGE ON_CARD(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CASE_ON"
CREATE DIRECTED EDGE CONNECTED_TO(FROM ClosedCase, TO Card) WITH REVERSE_EDGE="CONNECTED_CASE"
CREATE DIRECTED EDGE AC_INVOLVES(FROM AgentCase, TO Transaction) WITH REVERSE_EDGE="AC_INVOLVED_IN"
CREATE DIRECTED EDGE AC_ON_CARD(FROM AgentCase, TO Card) WITH REVERSE_EDGE="AC_CASE_ON"
CREATE DIRECTED EDGE AC_CONNECTED(FROM AgentCase, TO Card) WITH REVERSE_EDGE="AC_CONNECTED_CASE"
CREATE DIRECTED EDGE AC_DEVICE(FROM AgentCase, TO DeviceProfile) WITH REVERSE_EDGE="AC_DEVICE_CASE"
CREATE DIRECTED EDGE AC_SIMILAR(FROM AgentCase, TO ClosedCase) WITH REVERSE_EDGE="AC_SIMILAR_OF"
CREATE DIRECTED EDGE AC_SIMILAR_AGENT(FROM AgentCase, TO AgentCase) WITH REVERSE_EDGE="AC_SIMILAR_AGENT_OF"

CREATE GRAPH FraudGraph(*)
