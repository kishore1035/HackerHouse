CREATE GLOBAL SCHEMA_CHANGE JOB add_vectors {
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE emb(DIMENSION=1024, METRIC="COSINE");
  ALTER VERTEX PolicyChunk ADD VECTOR ATTRIBUTE emb(DIMENSION=1024, METRIC="COSINE");
  ALTER VERTEX AgentCase ADD VECTOR ATTRIBUTE emb(DIMENSION=1024, METRIC="COSINE");
}
RUN GLOBAL SCHEMA_CHANGE JOB add_vectors
